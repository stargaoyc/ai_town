# ===== 数据库 =====
DATABASE_URL=postgresql+asyncpg://ai_town:password@localhost:5432/ai_town
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
# 是否打印 SQL 日志（调试用，生产保持关闭）
DB_ECHO=false

# ===== 安全凭据（必填）=====
# docker-compose.yml 对以下变量做 ${VAR:?} 插值校验：缺失或为空时 compose 直接报错拒绝启动
# 强随机生成：openssl rand -hex 24
# REDIS_PASSWORD 会被拼接进 Redis 连接 URL，务必使用 hex 等不含 @ : / # ? 等特殊字符的值
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# 仅 observability profile 需要
GRAFANA_ADMIN_PASSWORD=

  # Alertmanager 告警回流后端的鉴权 token（R4-M2）：与后端 alert_webhook_token 同源，
  # 未配置时告警端点返回 403（告警仍可在 Grafana UI 查看）
  ALERT_WEBHOOK_TOKEN=

# 数据库定时备份（docker compose --profile backup up -d 启用 db-backup 服务）
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=14

# pgvector
EMBEDDING_DIM=2048

# ===== Redis =====
# compose 栈内的 Redis 已强制密码；本地裸机后端连接它时需带密码：
# redis://:<REDIS_PASSWORD>@localhost:6379/0（密码即上方 REDIS_PASSWORD 的值）
REDIS_URL=redis://localhost:6379/0

# ===== LLM 配置 =====
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_CHAT=gpt-4o-mini
MODEL_STRONG=gpt-4o
MODEL_FLASH=gpt-3.5-turbo
# 图像生成模型（仅 llm.generate_image 使用，勿复用文本推理模型计费）
MODEL_IMAGE=agnes-image-2.1-flash
# 群聊回复判定所用模型档位（chat 或 flash）；flash 更便宜，适合消息密集的群
GROUP_JUDGE_MODEL=chat
# ===== 认知功能批（20260825）=====
# 角色间多轮对话轮数（每轮双方各生成一句；硬上限 3，控制单次 chat_with 成本）
CHAT_WITH_MAX_ROUNDS=2
# 对话结束后由 LLM 评估关系增量（-10..10）替代固定 +5/+2；关闭则回退固定值
CHAT_QUALITY_ENABLED=true
# 用户对话 system prompt 注入 top-3 反思与最新日报（默认关闭保持上下文精简）
CHAT_INJECT_COGNITION=false
# OneBot 事件流长度上限（Redis Streams maxlen 近似裁剪，防无限增长）
ONEBOT_STREAM_MAXLEN=10000
# RANGE 分区表保留月数（超期整月分区自动 DETACH+DROP）
ACTION_RECORDS_RETENTION_MONTHS=12
STATE_HISTORY_RETENTION_MONTHS=6
# 消息表保留天数（0 = 永久保留）
MESSAGES_RETENTION_DAYS=180
MODEL_EMBEDDING=text-embedding-3-small
# Embedding 模型独立 API Key/URL（如使用 OpenRouter 等多模态服务）
EMBEDDING_MODEL_KEY=
EMBEDDING_MODEL_URL=
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
# LLM 单价（USD / 1M tokens），未在 LLM_MODEL_PRICES 配置的模型回退到此值。
# 默认为 agnes-2.0-flash 价格；更换模型供应商时必须同步修改，否则成本指标与日预算失真
LLM_PRICE_INPUT_PER_MTOKEN=0.5
LLM_PRICE_OUTPUT_PER_MTOKEN=1.5
# 按模型单价覆盖（USD / 1M tokens）。chat/strong/flash 常配不同价位模型，建议逐个配置：
# LLM_MODEL_PRICES={"gpt-4o-mini": {"input": 0.15, "output": 0.6}, "gpt-4o": {"input": 2.5, "output": 10.0}}
LLM_MODEL_PRICES=
# 多模型备用源（JSON 数组，按顺序尝试；主源失败冷却后仍可作末位兜底）：
# LLM_FALLBACK_SOURCES=[{"api_key": "sk-xxx", "base_url": "https://...", "model": "可选，缺省用 MODEL_CHAT"}]
LLM_FALLBACK_SOURCES=[]

# ===== 工具（已内联到后端进程，无需独立服务） =====
# 启用/禁用通过 Redis hash `tools:enabled` 或前端设置页管理

# ===== 可观测性 =====
# 本地裸机运行填 http://localhost:4318；Docker Compose 内 backend 需填 http://jaeger:4318
# （jaeger 宿主映射为 14318:4318，容器间走服务名直连 4318）
OTEL_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=ai-town-backend
OTEL_TRACES_SAMPLER_RATE=0.5
LANGFUSE_PUBLIC_KEY=pk-xxx
LANGFUSE_SECRET_KEY=sk-xxx
LANGFUSE_HOST=http://localhost:3001
LOKI_URL=http://loki:3100
LOG_LEVEL=info
LOG_FORMAT=json
# 日志文件轮转：单文件最大字节数与保留份数（data/logs/backend.log）
LOG_FILE_MAX_BYTES=50000000
LOG_BACKUP_COUNT=5

# ===== 消息平台 =====
ONEBOT_DEFAULT_CHARACTER_ID=
# 机器人自身 QQ 号（可选，也可从 OneBot 事件 self_id 获取）
ONEBOT_SELF_ID=
# 群聊是否仅在被 @ 时回复（默认 false：读取所有群消息并智能决策）
ONEBOT_GROUP_AT_ONLY=false
# 群组-角色映射：JSON 字符串 {"群号": "角色UUID"}，未配置的群使用默认角色
ONEBOT_GROUP_CHARACTER_MAP={}
# OneBot 反向 WS 接入令牌（配置后强制校验，OneBot 实现需带 Authorization: Bearer 或 access_token 连接）。
# 生产环境必须配置：ENVIRONMENT=production 且未配置时后端拒绝启动（无令牌端点可被任意伪造 QQ 事件）
ONEBOT_ACCESS_TOKEN=
# 单群/单私聊每分钟入站消息上限（超限静默丢弃，防止洪泛打爆 LLM 预算；0=禁用）
ONEBOT_RATE_LIMIT_PER_MINUTE=20

# ===== 运行环境与 CORS =====
# production 时启用安全 fail-fast（src/security/startup_checks.py：默认弱口令直接禁止启动）
ENVIRONMENT=development
# 允许的前端来源（逗号分隔的具体域名）。生产必须配置实际值，
# 如 https://town.example.com；allow_credentials 与通配符 * 互斥，禁止填 *
CORS_ORIGINS=

# ===== 鉴权 =====
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
API_KEY=your-api-key
# RBAC 角色配置（逗号分隔的用户名:角色列表，角色可选 admin/operator/viewer）
# 示例：admin:admin,viewer1:viewer,operator1:operator
# 未配置时所有用户默认 viewer（最小权限），admin 需在此显式配置
RBAC_ROLES=

# ===== 管理员账号 =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ===== 成本控制 =====
LLM_DAILY_BUDGET_USD=10.0
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

# ===== 世界历史保留 =====
# world_events 超期删除（天）；world_snapshots 仅保留最近 N 份（冷启动恢复真相源）
WORLD_EVENTS_RETENTION_DAYS=90
WORLD_SNAPSHOTS_KEEP_LATEST=3

# ===== 记忆系统 =====
# 是否启用 LLM 评分（对事件 1-10 分评估重要性，默认关闭使用规则评分）
MEMORY_LLM_SCORING_ENABLED=false

# 记忆保留：低/中重要性记忆超期清理，高重要性（>=7）永久保留
MEMORY_RETENTION_ENABLED=true
MEMORY_RETENTION_LOW_IMPORTANCE_DAYS=90
MEMORY_RETENTION_MID_IMPORTANCE_DAYS=180

# 认知产物保留（天），0 = 永久保留
# 反思：仅清理 tier=1 批次产物，tier=2 元反思永久保留
REFLECTION_RETENTION_DAYS=365
# 角色日记
DIARY_RETENTION_DAYS=730
# Person Memory 已压缩（compacted）的事实条目
PERSON_MEMORY_ENTRY_RETENTION_DAYS=180
# source_type=archive 的归档记忆行
ARCHIVE_EPISODE_RETENTION_DAYS=365

# 记忆压缩归档：清理前先按角色×月份 LLM 压缩成归档行，绝不未压缩先删除
MEMORY_COMPRESSION_ENABLED=true
# 单组少于该条数不压缩（摘要收益低于成本）
MEMORY_COMPRESSION_MIN_BATCH=5
# 单周期最多处理的候选条数
MEMORY_COMPRESSION_BATCH_LIMIT=300

# 改写式去重：向量化时与同角色近窗口记忆余弦比对，高度重复则改写合并
MEMORY_DEDUP_ENABLED=true
MEMORY_DEDUP_SIMILARITY_THRESHOLD=0.95
MEMORY_DEDUP_WINDOW_HOURS=24

# 当日计划滚动过期时长（创建超过 TTL 的 active daily 置 expired）
DAILY_PLAN_TTL_HOURS=24
# HNSW 向量检索参数：调大提升召回率、增加延迟
HNSW_EF_SEARCH=100
# Person Memory 未压缩事实条目达到该阈值后合并进主档
PERSON_MEMORY_COMPACT_THRESHOLD=20

# ===== 2026-08-26 审查修复批次：认知/维护/构建旋钮 =====
# Docker 构建走清华镜像（apt/pip/uv）；CI 环境不设此变量保持官方源
# USE_CN_MIRROR=true
# 反思触发：未反思记忆达到阈值触发批次反思；单次归纳记忆池上限
REFLECTION_THRESHOLD=20
REFLECTION_POOL_SIZE=30
# 元反思：累计反思达标且冷却期满后做跨期归纳
META_REFLECTION_MIN_TOTAL=6
META_REFLECTION_COOLDOWN_DAYS=7
# 计划-行动启发式对账：Action 与计划标题重叠超阈值时自动推进进度
PLAN_AUTO_PROGRESS_ENABLED=true
PLAN_AUTO_PROGRESS_DELTA=10
PLAN_AUTO_PROGRESS_OVERLAP=0.34
# HNSW 索引周期在线重建（保留期 DELETE 后索引不收缩；0 关闭）
HNSW_REINDEX_ENABLED=true
HNSW_REINDEX_INTERVAL_DAYS=30
# Person Memory 热度上限（防高频用户排序垄断）
PERSON_MEMORY_HEAT_CAP=500
# 传闻单源传播上限（同一事件窗口内最多扩散听者数）
GOSSIP_MAX_LISTENERS_PER_SOURCE=3
# 公开只读 GET 每 IP 限流（次/分钟，0 关闭）
PUBLIC_GET_RATE_LIMIT_PER_MINUTE=120

# ===== 世界引擎 =====
# World Tick 间隔（秒）：每隔多少秒执行一次世界推进
WORLD_TICK_SECONDS=30
# 每次 Tick 推进多少分钟虚拟时间（支持小数）
# 时间流速 = WORLD_TICK_MINUTES / WORLD_TICK_SECONDS（虚拟分钟/现实秒）
# 默认 10/30 = 0.33 → 1现实秒 = 20虚拟分钟（20倍速）
# 1:1现实同步：WORLD_TICK_SECONDS=60, WORLD_TICK_MINUTES=1.0
# 2倍速：WORLD_TICK_SECONDS=30, WORLD_TICK_MINUTES=1.0
# 10倍速：WORLD_TICK_SECONDS=30, WORLD_TICK_MINUTES=5.0
WORLD_TICK_MINUTES=10
# 虚拟世界初始时间（ISO 格式，如 "2026-07-01T08:00:00"）；留空则使用当前现实日期 08:00
WORLD_INITIAL_TIME=
WORLD_WEATHER_INTERVAL=60
# 每 N Tick 持久化差分事件到 world_events
WORLD_SNAPSHOT_INTERVAL=10
# 每 N Tick 存一次完整快照到 world_snapshots（冷启动恢复）
WORLD_FULL_SNAPSHOT_INTERVAL=1000
CHARACTER_TICK_SECONDS=30
CHARACTER_MAX_CONCURRENT=10
CHARACTER_LOCK_TTL_SECONDS=30

# ===== 主动分享配置 =====
SHARE_COOLDOWN_SECONDS=1800
SHARE_DAILY_LIMIT=8
SHARE_PROBABILITY_ACTION=0.6
SHARE_PROBABILITY_MOOD=0.5
SHARE_PROBABILITY_LOCATION=0.2
SHARE_PROBABILITY_ROUTINE=0.15

# ===== 群体动力学·传闻传播 =====
# 好友的高重要性经历以第二手记忆扩散（沿既有社交关系流动）
GOSSIP_ENABLED=true
# 源记忆重要性门槛（仅显著经历值得传播）
GOSSIP_IMPORTANCE_THRESHOLD=7
# 源记忆与去重回窗（小时）；每好友每窗口最多传播 1 条
GOSSIP_WINDOW_HOURS=24
# 单次 Tick 最多传播条数（控制记忆膨胀速率）
GOSSIP_MAX_PER_TICK=1
# 好友关系强度门槛
GOSSIP_RELATION_MIN=20
